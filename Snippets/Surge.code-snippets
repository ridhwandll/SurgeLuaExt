{
    "Surge Entity Script": {
        "prefix": "surge-script",
        "description": "Entity script: Properties, OnCreate and OnUpdate",
        "body": [
            "Properties = {",
            "\t${1:Speed} = Property.Float(${2:5.0}, ${3:0.0}, ${4:20.0}, \"${5:Units per second}\"),",
            "}",
            "",
            "---@param entity Entity",
            "function OnCreate(entity)",
            "\t$0",
            "end",
            "",
            "---@param entity Entity",
            "---@param deltaTime number",
            "function OnUpdate(entity, deltaTime)",
            "end"
        ]
    },
    "Surge Module": {
        "prefix": "surge-module",
        "description": "Module shared through require()",
        "body": [
            "local ${1:${TM_FILENAME_BASE}} = {}",
            "",
            "$0",
            "",
            "return ${1}"
        ]
    },
    "OnCreate": {
        "prefix": "OnCreate",
        "description": "Once, the frame the script starts",
        "body": ["---@param entity Entity", "function OnCreate(entity)", "\t$0", "end"]
    },
    "OnEnable": {
        "prefix": "OnEnable",
        "description": "After OnCreate, and whenever the script is enabled again",
        "body": ["---@param entity Entity", "function OnEnable(entity)", "\t$0", "end"]
    },
    "OnDisable": {
        "prefix": "OnDisable",
        "description": "When disabled, and before OnDestroy",
        "body": ["---@param entity Entity", "function OnDisable(entity)", "\t$0", "end"]
    },
    "OnUpdate": {
        "prefix": "OnUpdate",
        "description": "Every frame",
        "body": ["---@param entity Entity", "---@param deltaTime number", "function OnUpdate(entity, deltaTime)", "\t$0", "end"]
    },
    "OnLateUpdate": {
        "prefix": "OnLateUpdate",
        "description": "Every frame, after every OnUpdate (cameras, follow logic)",
        "body": ["---@param entity Entity", "---@param deltaTime number", "function OnLateUpdate(entity, deltaTime)", "\t$0", "end"]
    },
    "OnFixedUpdate": {
        "prefix": "OnFixedUpdate",
        "description": "Before every physics step, forces go here",
        "body": ["---@param entity Entity", "---@param fixedDeltaTime number", "function OnFixedUpdate(entity, fixedDeltaTime)", "\t$0", "end"]
    },
    "OnDestroy": {
        "prefix": "OnDestroy",
        "description": "Entity destroyed, scene unloaded or Play stopped",
        "body": ["---@param entity Entity", "function OnDestroy(entity)", "\t$0", "end"]
    },
    "OnCollisionEnter": {
        "prefix": "OnCollisionEnter",
        "description": "Physics contact begins",
        "body": ["---@param entity Entity", "---@param other Entity", "function OnCollisionEnter(entity, other)", "\t$0", "end"]
    },
    "OnCollisionExit": {
        "prefix": "OnCollisionExit",
        "description": "Physics contact ends ('other' may be destroyed already: check other:IsValid())",
        "body": ["---@param entity Entity", "---@param other Entity", "function OnCollisionExit(entity, other)", "\tif not other:IsValid() then return end", "\t$0", "end"]
    },
    "OnTriggerEnter": {
        "prefix": "OnTriggerEnter",
        "description": "A sensor (IsSensor) contact begins",
        "body": ["---@param entity Entity", "---@param other Entity", "function OnTriggerEnter(entity, other)", "\t$0", "end"]
    },
    "OnTriggerExit": {
        "prefix": "OnTriggerExit",
        "description": "A sensor contact ends ('other' may be destroyed already: check other:IsValid())",
        "body": ["---@param entity Entity", "---@param other Entity", "function OnTriggerExit(entity, other)", "\tif not other:IsValid() then return end", "\t$0", "end"]
    },
    "Properties": {
        "prefix": "Properties",
        "description": "Per-entity values edited in the Inspector (read them inside the callbacks)",
        "body": ["Properties = {", "\t$0", "}"]
    },
    "Property.Float": {
        "prefix": "prop-float",
        "body": "${1:Name} = Property.Float(${2:1.0}, ${3:0.0}, ${4:10.0}, \"${5:Tooltip}\"),"
    },
    "Property.Int": {
        "prefix": "prop-int",
        "body": "${1:Name} = Property.Int(${2:1}, ${3:0}, ${4:10}, \"${5:Tooltip}\"),"
    },
    "Property.Bool": {
        "prefix": "prop-bool",
        "body": "${1:Name} = Property.Bool(${2|true,false|}, \"${3:Tooltip}\"),"
    },
    "Property.String": {
        "prefix": "prop-string",
        "body": "${1:Name} = Property.String(\"${2}\", \"${3:Tooltip}\"),"
    },
    "Property.Vec3": {
        "prefix": "prop-vec3",
        "body": "${1:Name} = Property.Vec3(${2:0}, ${3:0}, ${4:0}, \"${5:Tooltip}\"),"
    },
    "Property.Color": {
        "prefix": "prop-color",
        "body": "${1:Tint} = Property.Color(${2:1}, ${3:1}, ${4:1}, ${5:1}, \"${6:Tooltip}\"),"
    },
    "Property.Entity": {
        "prefix": "prop-entity",
        "description": "nil when nothing is assigned",
        "body": "${1:Target} = Property.Entity(\"${2:Tooltip}\"),"
    },
    "Property.Asset": {
        "prefix": "prop-asset",
        "description": "The script gets the asset's path, ready for SetMesh, SetAudioClip, Scene.Load...",
        "body": "${1:Asset} = Property.Asset(\"${2|MESH,TEXTURE2D,AUDIO,MATERIAL,SCRIPT,FONT,SCENE,UI_LAYOUT,PARTICLE_EFFECT|}\", nil, \"${3:Tooltip}\"),"
    },
    "Property.Enum": {
        "prefix": "prop-enum",
        "body": "${1:Mode} = Property.Enum(\"${2:A}\", { \"${2:A}\", \"${3:B}\" }, \"${4:Tooltip}\"),"
    },
    "Property.Array": {
        "prefix": "prop-array",
        "body": "${1:Items} = Property.Array(\"${2|Float,Int,Bool,String,Vec2,Vec3,Vec4,Color,Entity,Asset|}\", nil, \"${3:Tooltip}\"),"
    },
    "require": {
        "prefix": "require",
        "description": "Module from the Assets folder (Scripts.Game.State = Assets/Scripts/Game/State.lua)",
        "body": "local ${1:Module} = require(\"${2:Scripts.${1}}\")"
    },
    "Raycast": {
        "prefix": "raycast",
        "body": [
            "local hit = Physics.Raycast(${1:origin}, ${2:direction}, ${3:100.0})",
            "if hit and hit.Entity then",
            "\t$0",
            "end"
        ]
    },
    "Touches": {
        "prefix": "touches",
        "description": "Every active touch (left mouse counts as one on desktop)",
        "body": [
            "for i = 1, Input.GetTouchCount() do",
            "\tlocal touch = Input.GetTouch(i)",
            "\t$0",
            "end"
        ]
    },
    "Find Widget": {
        "prefix": "findwidget",
        "body": [
            "local ${1:button} = entity.UICanvasC:FindWidget(\"${2:Name}\") --[[@as ${3|UIButton,UIText,UIImage,UIImageButton,UIProgressBar,UIToggle,UISlider,UIJoystick,UIScrollView,UIListView,UIInputField,UIDropdown,UIModal,UITabView|}]]"
        ]
    },
    "On Click": {
        "prefix": "onclick",
        "body": [
            "${1:button}:OnClick(function(self)",
            "\t$0",
            "end)"
        ]
    },
    "Diagnostics Stats": {
        "prefix": "getstats",
        "description": "Reuse one table so reading the stats creates no garbage",
        "body": [
            "local stats = {}",
            "Diagnostics.GetStats(stats)",
            "Log.Info(string.format(\"%.1f FPS, CPU %.2f ms, GPU %.2f ms\", stats.FPS, stats.CPUWorkMs, stats.GPUWorkMs))"
        ]
    }
}
